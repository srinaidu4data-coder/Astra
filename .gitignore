# Dependencies & build
node_modules/
dist/
dist-ssr/
*.local

# Separate upstream clone (own git remote) — keep local, don't nest in Astra commits
career-ops/

# Python
**/venv/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
*.db

# Lab apply telemetry (PII-adjacent URLs / KPI) — local only
src/data/apply_metrics.json
src/data/apply_audit.jsonl

# Env / secrets
.env
**/.env
*.pem

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Large archives & packaged builds
*.zip
v1.2/
v1.2-extracted/
astra-mvp/

# Electron packaged installers (host on Releases/CDN, not git)
interview-pulse-ai/release/
interview-pulse-ai/public/downloads/*.exe
interview-pulse-ai/public/downloads/*.dmg
interview-pulse-ai/public/downloads/*.AppImage
!interview-pulse-ai/public/downloads/README.txt

# Local debug / screenshots
interview-pulse-ai/blank-debug*
screenshots/
package-lock.json

# Playwright
.playwright-mcp/
test-results/
playwright-report/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local audio caches / chroma if huge
**/chroma_db/
src/localhost_*.log

# Agent / test artifact dumps (keep code, not local result blobs)
src/_lifecycle_*.json
src/_long_interview_loop_result.json
src/_stt_accuracy_result.json
src/_verify_latency_quality_result.json
src/jobsearch_supervisor.heartbeat
src/data/*.db
src/data/*.db-*
tmp-ai-job-search/
.grok/

# Large generated practice audio (regenerate via scripts)
src/test_audio/*.mp3
src/test_audio/*.wav
src/jd and resume/*.mp3
src/jd and resume/*.wav
# Keep JD text + resume PDF + question banks
!src/jd and resume/*.txt
!src/jd and resume/*.pdf
!src/jd and resume/*.json
