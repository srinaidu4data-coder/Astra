# GROQ_API_KEY=
# DEEPGRAM_API_KEY=
# Cascade: template/cache first paint, then optional LLM refine
ASTRA_TEMPLATE_FIRST=1
ASTRA_LLM_REFINE=1
ASTRA_ANSWER_CACHE_SIZE=256
ASTRA_CACHE_SIM=0.88
OPENAI_TIMEOUT=12
