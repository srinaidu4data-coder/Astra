# Copy to .env and fill in. Never commit real secrets.

OPENAI_API_KEY=

# --- Google sign-in (FastAPI OAuth — already wired) ---
# Stack: React Vite UI + Python FastAPI. NOT NextAuth / Passport / GIS.
# Flow: UI → GET /v1/auth/google → Google consent → GET /v1/auth/google/callback
#       → backend exchanges code → JWT → redirect FRONTEND_URL/#/auth/callback?token=...
#
# LOCAL:
#   JS origins: http://localhost:5173  http://127.0.0.1:5173
#   Redirect:   http://127.0.0.1:8787/v1/auth/google/callback
# PRODUCTION (jobinterviewcracker.com) — see .env.production.example + docs/GOOGLE_SIGNIN_JOBINTERVIEWCRACKER.md
#   JS origins: https://jobinterviewcracker.com
#   Redirect:   https://api.jobinterviewcracker.com/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/v1/auth/google/callback

# --- Email / password + forgot-password (Gmail SMTP sends reset link) ---
EMAIL_PASSWORD_AUTH_ENABLED=true
PASSWORD_RESET_EXPIRE_MINUTES=60

# Session JWT issued by this API after Google (or email) login — not AUTH_SECRET / NextAuth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=168
AUTH_REQUIRED=true
# Local only — never true in production
AUTH_DEV_BYPASS=false

FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://127.0.0.1:8787

# --- Welcome + billing emails (Gmail SMTP app password) ---
# Google Account → Security → 2-Step Verification → App passwords
# Paste the 16-char password (spaces are stripped automatically).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=
SMTP_FROM=InterviewPulse <your@gmail.com>
WELCOME_EMAIL_ENABLED=true
BILLING_EMAIL_ENABLED=true

# --- Stripe monthly subscription ---
# Dashboard → Developers → API keys; Products → monthly Recurring price → price_...
# Webhook endpoint: http://127.0.0.1:8787/v1/billing/webhook
# Events: checkout.session.completed, customer.subscription.*, invoice.payment_*,
#         charge.refunded, charge.refund.updated, charge.dispute.created
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# {CHECKOUT_SESSION_ID} is required — used to unlock without waiting on webhooks
STRIPE_SUCCESS_URL=http://localhost:5173/#/billing?checkout=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:5173/#/billing?checkout=cancel

DATABASE_URL=sqlite:///./astra_backend.db
