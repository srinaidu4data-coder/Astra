# Production template for https://jobinterviewcracker.com
# Copy to the server as src/.env (never commit real secrets).

OPENAI_API_KEY=

# --- Public URLs (HTTPS) ---
# UI:  https://jobinterviewcracker.com
# API: https://api.jobinterviewcracker.com   (recommended subdomain)
FRONTEND_URL=https://jobinterviewcracker.com
PUBLIC_API_URL=https://api.jobinterviewcracker.com

# Bind API for reverse proxy (nginx/Caddy → this process)
COPILOT_API_HOST=0.0.0.0
COPILOT_API_PORT=8787

# --- Google sign-in (required for "Continue with Google") ---
# Google Cloud Console → APIs & Services → Credentials
#   Create OAuth client: Web application
#   Name: Job Interview Cracker
#
# Authorized JavaScript origins:
#   https://jobinterviewcracker.com
#   https://www.jobinterviewcracker.com
#
# Authorized redirect URIs (must match GOOGLE_REDIRECT_URI exactly):
#   https://api.jobinterviewcracker.com/v1/auth/google/callback
#
# OAuth consent screen:
#   User type: External (or Internal for Workspace-only)
#   App name: Job Interview Cracker
#   Authorized domains: jobinterviewcracker.com
#   Scopes: openid, email, profile (default)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.jobinterviewcracker.com/v1/auth/google/callback

# Session JWT — generate a long random string, e.g. openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE_HOURS=168

# Force Google/email sign-in on the live site
AUTH_REQUIRED=true
AUTH_DEV_BYPASS=false
EMAIL_PASSWORD_AUTH_ENABLED=true
PASSWORD_RESET_EXPIRE_MINUTES=60

# --- Welcome / reset emails (Gmail app password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Job Interview Cracker <noreply@jobinterviewcracker.com>
WELCOME_EMAIL_ENABLED=true
BILLING_EMAIL_ENABLED=true

# --- Stripe (optional until you sell subscriptions) ---
# Without Stripe keys, signed-in users skip the paywall and enter the app.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_SUCCESS_URL=https://jobinterviewcracker.com/#/billing?checkout=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://jobinterviewcracker.com/#/billing?checkout=cancel

DATABASE_URL=sqlite:///./astra_backend.db
